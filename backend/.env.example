# BrandPulse AI backend configuration. Copy to `.env` and fill in real values:
#   cp .env.example .env
# Every field of app/config/settings.py is listed here (tests/unit/test_settings.py checks it).
# Real secrets belong in `.env` (git-ignored), never in this file.

# --- Database (PostgreSQL 16, e.g. Supabase) -----------------------------------------------
# Pooled connection used by the running app. With Supabase's transaction pooler, disable
# prepared statements in the driver (psycopg 3: prepare_threshold=None).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Direct or session-mode connection. Used by Alembic migrations (`alembic upgrade head`).
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- SerpApi ---------------------------------------------------------------------------------
SERPAPI_API_KEY=
SERPAPI_ACCOUNT_LABEL=default
# Live SerpApi calls spend credits. Keep false unless you intend to collect new data.
ALLOW_LIVE_SERPAPI=false
SERP_MONTHLY_LIMIT=250
SERP_MONTHLY_RESERVE=20
SERP_BUDGET_PER_ANALYSIS=12
SERP_BUDGET_PER_INVESTIGATION=8
SERP_CACHE_TTL_HOURS=720
# Set a long random code: it is required in the X-Access-Code header for live requests.
LIVE_ACCESS_CODE=

# --- Limits ----------------------------------------------------------------------------------
MAX_ANALYSES_PER_DAY=3
MAX_CONCURRENT_ANALYSES=1

# --- Local NLP -------------------------------------------------------------------------------
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Optional Hugging Face cache directory (empty = library default).
HF_HOME=

# --- Groq (investigation report writing; the fallback report is used when unset) ---------------
GROQ_API_KEY=
# Empty = llama-3.1-8b-instant.
GROQ_MODEL=
# Simultaneous Groq requests across all investigations.
LLM_MAX_CONCURRENCY=1
# Groq calls allowed per investigation (0 = never call the model).
LLM_MAX_CALLS_PER_INVESTIGATION=8

# --- App -------------------------------------------------------------------------------------
# true = serve the bundled demo data with no database, model or network.
DEMO_MODE=false
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# CRITICAL, ERROR, WARNING, INFO or DEBUG.
LOG_LEVEL=INFO
