# Copy to .env (never commit .env). Placeholder values only.

# Database (Supabase Postgres). DATABASE_URL = pooled app connection; DATABASE_URL_DIRECT = for Alembic.
DATABASE_URL=
DATABASE_URL_DIRECT=

# SerpApi (free plan: 250 searches/month). Live calls stay OFF by default.
SERPAPI_API_KEY=
SERPAPI_ACCOUNT_LABEL=default
ALLOW_LIVE_SERPAPI=false
SERP_MONTHLY_LIMIT=250
SERP_MONTHLY_RESERVE=20
SERP_BUDGET_PER_ANALYSIS=12
SERP_BUDGET_PER_INVESTIGATION=8
SERP_CACHE_TTL_HOURS=720

# Optional access code for live runs. Empty = no check (local use).
LIVE_ACCESS_CODE=

# Limits
MAX_ANALYSES_PER_DAY=3
MAX_CONCURRENT_ANALYSES=1

# Local NLP
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_HOME=

# Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=
LLM_MAX_CONCURRENCY=1
LLM_MAX_CALLS_PER_INVESTIGATION=8

# App
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Tests only (not read by the app): a Postgres server URL whose role can CREATE DATABASE.
# Export it in your shell to run the migration tests. Do not point it at real data.
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/postgres
